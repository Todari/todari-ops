# Content renderer and publisher. The Discord gateway runs in the core image.
FROM node:22-bookworm-slim
WORKDIR /app
RUN corepack enable && apt-get update && apt-get install -y --no-install-recommends \
    git bash ca-certificates python3 python3-venv ffmpeg chromium fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*
COPY deploy/content-requirements.txt /tmp/content-requirements.txt
RUN python3 -m venv /opt/content-venv && /opt/content-venv/bin/pip install --no-cache-dir -r /tmp/content-requirements.txt
COPY scripts/content_pipeline.py scripts/content_revision.py scripts/content_worker.py scripts/science_sources.py ./scripts/
COPY deploy/content_preflight.py deploy/instatoon_preflight.py ./deploy/
RUN mkdir -p /data/work && chown -R node:node /data
ENV PYTHONDONTWRITEBYTECODE=1 REMOTION_BROWSER_EXECUTABLE=/usr/bin/chromium
USER node
CMD ["/opt/content-venv/bin/python3", "scripts/content_worker.py"]
