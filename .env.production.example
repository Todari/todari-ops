# Production env for EC2/docker-compose. NEVER commit this file with real values.
# Copy from local .env and adjust paths for container:
#
#   cp .env .env.production
#   # change WORK_DIR=./data/work  →  WORK_DIR=/data/work
#   # set NODE_ENV=production
#   # ensure ANTHROPIC_API_KEY and DISCORD_BOT_TOKEN are the rotated values

DISCORD_BOT_TOKEN=
DISCORD_APP_ID=
DISCORD_GUILD_ID=
OWNER_DISCORD_ID=

# === Claude 인증 — A 또는 B 둘 중 하나만 필요 ===
# A. Max/Pro 구독 (권장 — 별도 결제 X). 로컬에서 `claude setup-token` 으로 발급
CLAUDE_CODE_OAUTH_TOKEN=
# B. API key (pay-per-token, console.anthropic.com)
ANTHROPIC_API_KEY=

WORK_DIR=/data/work
AUDIT_DB_URL=
# private code clone + VAULT_REPO_URL Contents read/write
GITHUB_TOKEN=
VERCEL_TOKEN=
SENTRY_API_TOKEN=
SENTRY_DSN=
# read-only Q&A + bounded /task /idea /note instant capture
VAULT_REPO_URL=https://github.com/example/private-vault.git

# === Inbound alerts webhook ===
ALERTS_CHANNEL_ID=
SENTRY_WEBHOOK_SECRET=
# GitHub repo webhooks (pull_request + workflow_run) — generate any random hex,
# register the same value on each repo webhook (README §6)
GITHUB_WEBHOOK_SECRET=
# Vercel team webhook secret — issued by Vercel when creating the webhook
# (Team Settings → Webhooks), events: deployment.error/canceled/succeeded
VERCEL_WEBHOOK_SECRET=
# Mac vault_sync.py 가 볼트 할 일/일정을 push 할 때 쓰는 HMAC 시크릿
# (~/.claude/hooks/workspace-harness/ops.env 와 동일 값)
VAULT_SYNC_SECRET=
# 야있날·섹터4 게시 성공 알림 HMAC 시크릿과 전용 Discord 채널
INSTAGRAM_WEBHOOK_SECRET=
INSTAGRAM_CHANNEL_ID=1539849876429475841
WEBHOOK_ENABLED=true

# /task /idea /note 즉시 반영 실패 시 쓰는 안전 큐. 비우면 ALERTS_CHANNEL_ID 로 폴백
INBOX_CHANNEL_ID=

# === Voice capture (인박스 채널의 음성 메시지 → 볼트 캡처 제안, docs/voice-capture.md) ===
# 키가 있으면 켜진다. 음성 파일과 프로젝트·허브 노트 이름이 Google Gemini API 로 전송된다.
# 콘텐츠 런타임을 켠 서버는 .env.content 의 같은 키를 봇도 함께 쓴다. 그 키를 가리지 않게 빈 값으로 두지 않는다
# GEMINI_API_KEY=
# 받아쓰기·정리에 쓰는 Gemini 모델 ID. 비우면 gemini-3.8-flash
VOICE_MODEL=gemini-3.8-flash

# === Uptime monitor (projects.ts healthUrl 대상) ===
UPTIME_ENABLED=true
UPTIME_INTERVAL_MS=300000
BOT_PUBLIC_HOST=ops.example.com

# === Daily digest ===
# 비우면 비활성화. KST HH:MM
DIGEST_TIME=08:30
# 비우면 ALERTS_CHANNEL_ID 로 게시
DIGEST_CHANNEL_ID=

# === Auto pre-diagnosis (Sentry/CI 알림 시 읽기 전용 원인 분석) ===
# 하루 실행 상한 (KST). 0 = 끔
DIAG_DAILY_CAP=3

# 봇의 모든 에이전트 세션이 쓰는 모델 (기본 claude-opus-5, 빈 값 = SDK 번들 기본)
CLAUDE_MODEL=claude-opus-5

# === Evening check-in (모달 회고 → 데일리 노트 + 다음날 첫 작업) ===
# KST HH:MM. 비우면 끔
CHECKIN_TIME=21:30

# === Auto daily log (봇이 어제 하루를 볼트 데일리 노트에 기록, docs/daily-log.md) ===
# KST HH:MM. 비우면 끔. 그 시각 기준 "어제"를 쓰므로 자정 뒤로 둔다
DAILY_LOG_TIME=00:40
# 커밋의 작성자로 볼 GitHub 로그인. 비우면 GITHUB_TOKEN 의 주인(GET /user)
DAILY_LOG_AUTHOR=
# 커밋 검색을 이 GitHub 사용자·조직의 레포로 더 좁힌다(쉼표 구분). 비우면 좁히지 않는다
DAILY_LOG_OWNERS=

# === HTTPS termination ===
# Point the public hostname at the bot's published port through your reverse
# proxy. See README for a generic nginx example.

ACTION_ALLOWLIST=Edit,Write,Bash

PORT=3000
NODE_ENV=production
