# === Required ===
ANTHROPIC_API_KEY=
DISCORD_BOT_TOKEN=
DISCORD_APP_ID=
DISCORD_GUILD_ID=
OWNER_DISCORD_ID=

# === Workspace ===
# Where per-thread project checkouts live. In Fly, mount as volume → /data/work.
WORK_DIR=./data/work

# === Audit log ===
# If empty, audit goes to ./audit.log
AUDIT_DB_URL=

# === Service tokens (for git push, MCP integrations) ===
# Vault instant capture needs Contents read/write on VAULT_REPO_URL.
GITHUB_TOKEN=
VERCEL_TOKEN=
SENTRY_API_TOKEN=

# Private knowledge-base used by read-only Q&A and bounded instant capture.
VAULT_REPO_URL=https://github.com/example/private-vault.git

# === Error tracking (optional) ===
# Sentry DSN for the bot itself. Empty = disabled, no-op.
SENTRY_DSN=

# === Inbound alerts webhook (optional) ===
# Discord channel to post incoming Sentry alerts to (project-tagged embeds).
ALERTS_CHANNEL_ID=
# HMAC secret shared with Sentry Internal Integrations.
SENTRY_WEBHOOK_SECRET=
# HMAC secret shared with GitHub repo webhooks (pull_request + workflow_run).
GITHUB_WEBHOOK_SECRET=
# Secret issued by Vercel when creating a team webhook (deployment.* events).
VERCEL_WEBHOOK_SECRET=
# HMAC secret for POST /webhook/vault-sync (Mac-side vault_sync.py cron).
VAULT_SYNC_SECRET=
# HMAC secret shared with the 자꾸야구·섹터4 publishers.
INSTAGRAM_WEBHOOK_SECRET=
# Dedicated channel for successful Instagram publish notifications.
INSTAGRAM_CHANNEL_ID=
# Safety queue when an immediate /task /idea /note vault write fails.
# Falls back to ALERTS_CHANNEL_ID.
INBOX_CHANNEL_ID=
# Set to "false" to skip starting the HTTP server.
WEBHOOK_ENABLED=true

# === Uptime monitor ===
# Polls every projects.ts entry that has healthUrl. Alerts to ALERTS_CHANNEL_ID.
UPTIME_ENABLED=true
UPTIME_INTERVAL_MS=300000

# Public bot hostname to include in domain/TLS expiry checks. Empty = disabled.
BOT_PUBLIC_HOST=ops.example.com

# === Daily digest ===
# KST HH:MM. Empty = disabled. Posts to DIGEST_CHANNEL_ID (fallback: alerts).
DIGEST_TIME=08:30
DIGEST_CHANNEL_ID=

# === Action gate ===
# Comma-separated tool names that may be granted via Discord prompt.
# Tools NOT in this list are auto-denied if they're write tools.
ACTION_ALLOWLIST=Edit,Write,Bash

# === Server ===
PORT=3000
NODE_ENV=development
